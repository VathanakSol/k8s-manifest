# All MongoDB credentials. Both users are created on MongoDB's FIRST start
# only (empty data volume); editing this file later does not change them.
# Values go into a mongodb:// URI: letters and digits only. Generate with
#   openssl rand -hex 24
# and use a DIFFERENT password for each user.

# Graylog's own user (readWrite + dbAdmin on the graylog database only).
# Used by the Graylog server and the Data Node.
MONGODB_USERNAME=graylog
MONGODB_PASSWORD=changemeappuserpassword

# MongoDB root (admin) user. Only for you (backups, password changes);
# Graylog never uses it. Not needed with an external MongoDB.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changemerootpassword
