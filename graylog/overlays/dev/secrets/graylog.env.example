# Shared by the Graylog server and the Data Node. At least 16 characters
# (64+ recommended). NEVER change it after the first start: it encrypts
# stored secrets and salts user passwords.
#   openssl rand -hex 48
GRAYLOG_PASSWORD_SECRET=change-me-generate-with-openssl-rand-hex-48

# SHA-256 of the web UI password for the built-in "admin" user.
#   echo -n 'YourAdminPassword' | sha256sum | cut -d' ' -f1
# (The example below is the hash of "admin". Do not keep it.)
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
